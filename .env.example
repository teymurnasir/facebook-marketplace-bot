# Telegram — create a bot with @BotFather, then get your chat id
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# How often to scan (minutes) — overridden by Telegram /settings when sync is enabled
POLL_INTERVAL_MINUTES=30

# Playwright: set true to watch the browser while debugging
HEADLESS=true

# Path to Facebook login session (created by: python -m src.save_session)
FACEBOOK_STORAGE_STATE=storage_state.json

# Telegram /settings + /scan bridge (Cloudflare Worker). Required for local scanner mode.
SETTINGS_CONFIG_URL=https://marketplace-telegram-webhook.marketplace-bot.workers.dev/config
SETTINGS_CONFIG_TOKEN=
